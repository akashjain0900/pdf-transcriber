# Ledger — per-machine configuration.
#
# Copy to `.env` and edit. Every value here has a working default in
# config.py, so you only need the ones you want to change.
#
# Real environment variables override this file, so you can do
# `LEDGER_DPI=400 python -m ledger.cli run` for a one-off.


# --- Paths -----------------------------------------------------------

# The one parent folder holding THIS machine's PDFs. Subfolders are walked.
LEDGER_PDF_ROOT=./pdfs

# Working database. Holds every transcription AND your API keys, so treat
# this file as a secret and do not sync it anywhere public.
LEDGER_DB_PATH=./ledger.db

# Where `export` writes the JSONL files and manifests.
LEDGER_EXPORT_DIR=./exports


# --- Machine identity ------------------------------------------------

# Stamped onto every page this machine produces. Give each machine a
# different value so merged exports stay traceable.
LEDGER_MACHINE_ID=machine-1


# --- Rendering -------------------------------------------------------

# 300 is the sweet spot. Gemini caps visual detail at a fixed token budget,
# so going much above 400 costs render time and bandwidth for nothing.
LEDGER_DPI=300

# png (default) or webp. Both lossless. Avoid jpeg: its artifacts land on
# letter edges, which is the worst place for old type.
LEDGER_IMAGE_FORMAT=png

# Pages are sent in their original colour by default. Colour costs nothing —
# the model's token budget per image is fixed either way — and it helps with
# red rubrication, marginalia in different ink, and telling stains from ink.
LEDGER_GREYSCALE=false

# Straighten crooked scans. Costs CPU per page — turn on only if you see
# lines coming back out of order.
LEDGER_DESKEW=false


# --- Model -----------------------------------------------------------

LEDGER_MODEL=gemini-3.5-flash-lite

# ultra_high = 2240 image tokens vs 1120 at the default. On the free tier
# this is free, because one request is one request regardless of tokens.
LEDGER_MEDIA_RESOLUTION=ultra_high

# How much internal reasoning the model does before answering. Off by
# default: pointless for reading a page, and the field name could not be
# verified against a live endpoint, so a wrong name would fail every request.
# Leave empty unless you have confirmed the correct field name.
LEDGER_THINKING_LEVEL=


# --- Transcription behaviour -----------------------------------------

LEDGER_PRESERVE_LAYOUT=true

# Detect each book's language/script/era once. Costs one extra request per
# book, cached permanently.
LEDGER_PROFILE_BOOKS=true
LEDGER_PROFILE_SAMPLE_PAGES=3

# Only sample pages AFTER this one -- the opening pages of a scan are cover,
# endpapers, half-title and frontispiece, which describe the front matter
# rather than the book. Pages are also checked locally for real text before
# being used, so blanks and plates are skipped. That check costs no requests.
LEDGER_PROFILE_START_AFTER_PAGE=15

# Cap on how many pages the local text check inspects while hunting for
# samples, so a 600-page volume does not make this slow.
LEDGER_PROFILE_SCAN_LIMIT=40


# --- Concurrency -----------------------------------------------------

# One worker per key. No point exceeding your key count.
LEDGER_MAX_WORKERS=20

# Rendering is CPU-bound, unlike the API call. Roughly your core count.
LEDGER_MAX_CONCURRENT_RENDERS=4


# --- Reliability -----------------------------------------------------

LEDGER_MAX_PAGE_ATTEMPTS=3
LEDGER_REQUEST_TIMEOUT=180

# How long to wait when every key is spent for the day.
LEDGER_IDLE_SLEEP_SECONDS=300


# --- Scanning --------------------------------------------------------

# true reads every byte of every PDF for a real SHA-256. Accurate but slow
# across a large corpus. The default quick fingerprint is ample.
LEDGER_FULL_FILE_HASH=false
